diff --git i/crates/nsh-core/src/diag.rs w/crates/nsh-core/src/diag.rs
new file mode 100644
index 00000000..23e82d88
--- /dev/null
+++ w/crates/nsh-core/src/diag.rs
@@ -0,0 +1,126 @@
+//! Benchmark diagnostics (perf-bench patch): process-wide counters the
+//! engine, the core and the GPUI platform add to, read by the benchmark at
+//! phase boundaries. Relaxed atomics only; a span costs two clock reads.
+
+use std::sync::atomic::{AtomicU64, Ordering::Relaxed};
+use std::sync::Mutex;
+use std::time::Instant;
+
+macro_rules! counters {
+    ($($name:ident),* $(,)?) => {
+        /// A counter.
+        #[allow(non_camel_case_types, missing_docs)]
+        #[derive(Clone, Copy, Debug)]
+        #[repr(usize)]
+        pub enum C { $($name),* }
+        /// Counter names, in order.
+        pub const NAMES: &[&str] = &[$(stringify!($name)),*];
+    };
+}
+
+counters!(
+    // engine thread
+    eng_wakes, eng_busy_ns, eng_tasks_ns, eng_commit_ns, eng_commit_js_ns, eng_apply_ops_ns, eng_ops, eng_submits, eng_items,
+    // core commit rounds
+    core_rounds, core_layout_skipped, core_render_ns, core_flush_ns, core_layout_ns, core_layout_main, core_emit_ns, core_lists_ns, core_text_ns,
+    // text measuring (layout)
+    text_measure_calls, text_measures_unwrapped, text_measures_wrapped, text_measures_reused,
+    // reactive graph
+    rx_computations,
+    // mount items produced, by kind
+    it_frame, it_style, it_text, it_create, it_insert, it_remove, it_other,
+    // main thread
+    ui_drains, ui_drain_ns, ui_batches, ui_tick_ns, ui_anim_write_ns, ui_paint_ns, ui_paints, ui_notifies,
+);
+
+static VALUES: [AtomicU64; NAMES.len()] = [const { AtomicU64::new(0) }; NAMES.len()];
+
+/// Adds `v` to `c`.
+#[inline]
+pub fn add(c: C, v: u64) {
+    VALUES[c as usize].fetch_add(v, Relaxed);
+}
+
+/// The current value of `c`.
+pub fn get(c: C) -> u64 {
+    VALUES[c as usize].load(Relaxed)
+}
+
+/// All counters, by name.
+pub fn snapshot() -> Vec<(&'static str, u64)> {
+    NAMES.iter().zip(VALUES.iter()).map(|(n, v)| (*n, v.load(Relaxed))).collect()
+}
+
+/// Adds the time since `start` to `c`, in nanoseconds.
+#[inline]
+pub fn since(c: C, start: Instant) {
+    add(c, start.elapsed().as_nanos() as u64);
+}
+
+/// Times a scope into `c`.
+pub struct Span(C, Instant);
+impl Span {
+    /// Starts timing.
+    #[inline]
+    pub fn new(c: C) -> Span {
+        Span(c, Instant::now())
+    }
+}
+impl Drop for Span {
+    fn drop(&mut self) {
+        since(self.0, self.1);
+    }
+}
+
+/// When the main thread applied each mount batch (1-based, in the order the
+/// engine submitted them): the last ones, for matching draws to commits.
+static APPLIED: Mutex<Vec<(u64, Instant)>> = Mutex::new(Vec::new());
+
+/// The main thread applied batch number `n` at `at`.
+pub fn ui_applied(n: u64, at: Instant) {
+    let mut v = APPLIED.lock().unwrap();
+    if v.len() >= 1 << 16 {
+        v.drain(..1 << 15);
+    }
+    v.push((n, at));
+}
+
+/// When batch number `n` was applied on the main thread, if it was yet.
+pub fn ui_applied_at(n: u64) -> Option<Instant> {
+    let v = APPLIED.lock().unwrap();
+    let i = v.partition_point(|x| x.0 < n);
+    v.get(i).filter(|x| x.0 == n).map(|x| x.1)
+}
+
+/// Counts a mount item applied on the main thread, by kind.
+pub fn count_item(item: &crate::MountItem) {
+    use crate::MountItem as M;
+    add(
+        match item {
+            M::Frame { .. } => C::it_frame,
+            M::ViewStyle { .. } => C::it_style,
+            M::Text { .. } => C::it_text,
+            M::Create { .. } => C::it_create,
+            M::Insert { .. } => C::it_insert,
+            M::Remove { .. } | M::Delete { .. } => C::it_remove,
+            _ => C::it_other,
+        },
+        1,
+    );
+}
+
+/// A platform without a frame profiler reports the main-thread work that
+/// put a frame on screen (start, end) here; the benchmark installs the hook.
+static FRAME_HOOK: std::sync::OnceLock<fn(Instant, Instant)> = std::sync::OnceLock::new();
+
+/// Installs the frame hook ([`frame`]).
+pub fn set_frame_hook(f: fn(Instant, Instant)) {
+    let _ = FRAME_HOOK.set(f);
+}
+
+/// One frame of main-thread work that changed what the screen shows.
+pub fn frame(start: Instant, end: Instant) {
+    if let Some(f) = FRAME_HOOK.get() {
+        f(start, end);
+    }
+}
